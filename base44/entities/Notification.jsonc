{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string",
      "description": "Email of the recipient"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "client",
        "staff"
      ],
      "description": "Type of recipient"
    },
    "type": {
      "type": "string",
      "enum": [
        "booking_confirmed",
        "booking_reminder",
        "booking_cancelled",
        "review_reminder",
        "new_booking",
        "client_note_added"
      ],
      "description": "Notification type"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "booking_id": {
      "type": "string",
      "description": "Related booking ID"
    },
    "client_id": {
      "type": "string",
      "description": "Related client ID"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "email_sent": {
      "type": "boolean",
      "default": false
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "recipient_email",
    "recipient_type",
    "type",
    "title",
    "message"
  ]
}